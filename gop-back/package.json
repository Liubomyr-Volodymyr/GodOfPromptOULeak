{
  "name": "gop-back",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "local": "npm-run-all -p local:docker:up -r local:wait local:dev",
    "local:docker:up": "dotenv -e .env -- docker-compose up",
    "local:docker:down": "dotenv -e .env -- docker-compose down",
    "local:docker:build": "dotenv -e .env -- docker-compose build --no-cache",
    "typeorm": "dotenv -e .env -- ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate ./migrations/$npm_config_name -d orm.config.ts",
    "migration:run": "npm run typeorm migration:run -- -d orm.config.ts",
    "backfill:orders": "dotenv -e .env -- ts-node -r tsconfig-paths/register ./scripts/backfill-orders-from-stripe.ts",
    "migration:revert": "npm run typeorm migration:revert -- -d orm.config.ts",
    "local:wait": "wait-on tcp:$POSTGRES_PORT tcp:$REDIS_PORT tcp:$MLFLOW_PORT",
    "run:local": "dotenv -e .env.staging -- nest start --watch",
    "local:dev": "nest start --watch",
    "dev": "dotenv -e .env -- nest start --watch",
    "prod:db:migrate": "npm run typeorm -- migration:run",
    "prod:start": "node dist/main",
    "build": "nest build",
    "prettier": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.{ts,js}\"",
    "test": "jest --colors --verbose",
    "test:watch": "jest --watch",
    "test:staged": "jest --bail --findRelatedTests --passWithNoTests",
    "prepare": "husky install",
    "migrate": "ts-node cache/migration/main.ts"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "lint-staged": {
    "*.{ts}": [
      "eslint --fix",
      "prettier --write",
      "npm run test:staged"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.9",
    "@google-cloud/storage": "^7.14.0",
    "@google/genai": "^1.42.0",
    "@google/generative-ai": "^0.24.1",
    "@googleapis/drive": "^8.14.0",
    "@googleapis/oauth2": "^1.0.7",
    "@nestjs/axios": "^4.0.0",
